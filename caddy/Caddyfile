{
	# Strip the Server header; Caddy issues Let's Encrypt certs automatically
	# for the domain below and redirects plain HTTP to HTTPS by default.
	servers {
		trusted_proxies static private_ranges
	}
}

{$API_DOMAIN} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Server-Sent Events must reach the client immediately, not be buffered.
	@stream path /api/stream
	handle @stream {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /tiles/* {
		# PMTiles range requests are cross-origin fetches from the browser
		# (GitHub Pages or a local dev server), so they need the same CORS
		# origin restriction as the API. No wildcard in production.
		header Access-Control-Allow-Origin "{$CORS_ORIGIN}"
		header Access-Control-Allow-Methods "GET"
		root * /srv
		file_server {
			browse false
		}
	}

	handle {
		respond 404
	}
}
