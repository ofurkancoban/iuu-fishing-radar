# Global Fishing Watch API token (free, required). Never commit the real value.
GFW_API_TOKEN=

# Public HTTPS URL of the VPS API, used by the web/ frontend at build/config time.
API_BASE_URL=https://api.yourdomain.tld

# Exact GitHub Pages origin allowed by CORS on the API. No wildcards in production.
CORS_ORIGIN=https://yourusername.github.io

# Optional: Redis pub/sub backing the live SSE feed. Falls back to DB-cursor polling if unset.
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# Domain Caddy issues a TLS certificate for.
API_DOMAIN=api.yourdomain.tld

# Requests per minute per client IP allowed by the API.
RATE_LIMIT=60

# Default region key from config/regions.yml.
DEFAULT_REGION=default

# Grafana admin password (never leave as default in production).
GRAFANA_ADMIN_PASSWORD=
